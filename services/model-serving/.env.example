# Copy this file to .env and adjust values for your environment.
# .env itself is gitignored.
#
# This service has no real secrets: the serving app loads a bundled model
# artifact from disk (see README) and talks to no database, cache, or
# external API. Everything below is either a path or a non-sensitive
# tuning knob.

# --- Serving app (app/main.py) ---
MODEL_ARTIFACT_DIR=app/model_artifact
LOG_LEVEL=info

# --- Training/promotion scripts only (training/train.py, training/promote_model.py) ---
# Not read by the serving app. Defaults to a local SQLite-backed MLflow
# tracking store + local artifact dir if unset -- see training/train.py.
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_REGISTERED_MODEL_NAME=splice-junction-classifier
