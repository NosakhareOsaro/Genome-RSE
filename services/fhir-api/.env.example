# Copy this file to .env and adjust values for your environment.
# .env itself is gitignored -- never commit real secrets.
#
# The values below are placeholders. DEMO_CLIENT_SECRET and JWT_SIGNING_KEY
# are intentionally obvious non-secrets ("REPLACE_ME_NOT_A_REAL_SECRET") so
# nobody mistakes them for leaked credentials. Replace them with real
# generated values before running anywhere other than local development.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://fhir:fhir@localhost:5432/fhir

# --- Redis cache ---
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=60

# --- Demo OAuth2 Authorization Server ---
# See app/auth/README (and the top-level service README) -- this is a
# self-contained demo Authorization Server, NOT connected to a real EHR/IdP.
DEMO_CLIENT_ID=demo-client
DEMO_CLIENT_SECRET=REPLACE_ME_NOT_A_REAL_SECRET
JWT_SIGNING_KEY=REPLACE_ME_NOT_A_REAL_SECRET
JWT_EXPIRES_IN_SECONDS=3600

# --- Rate limiting ---
RATE_LIMIT=100/minute
