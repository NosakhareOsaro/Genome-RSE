{
  "name": "jbrowse-plugin-sv-tracks",
  "version": "0.1.0",
  "license": "MIT",
  "description": "JBrowse2 plugin rendering structural-variant arcs from a VCF, served by a small Flask backend (sv-tracks-backend)",
  "keywords": ["jbrowse", "jbrowse2", "genomics", "structural-variants"],
  "main": "dist/index.js",
  "files": ["dist", "src"],
  "scripts": {
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "build": "cross-env NODE_ENV=production rollup -c rollup.config.mjs",
    "start": "cross-env NODE_ENV=development rollup -c rollup.config.mjs --watch",
    "serve": "serve --cors --listen 9000 .",
    "dev": "concurrently \"npm run start\" \"npm run serve\"",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@eslint/js": "^9.0.0",
    "@jbrowse/core": "^4.2.0",
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-replace": "^6.0.2",
    "@rollup/plugin-terser": "^0.4.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@vitest/coverage-v8": "^2.1.0",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.0.0",
    "jsdom": "^25.0.0",
    "puppeteer": "^23.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rimraf": "^6.0.0",
    "rollup": "^4.24.0",
    "rollup-plugin-external-globals": "^0.13.0",
    "rxjs": "^7.8.1",
    "serve": "^14.2.3",
    "vitest": "^2.1.0"
  },
  "private": true
}
